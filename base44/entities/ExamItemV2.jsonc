{
  "name": "ExamItemV2",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "description": "Parent exam ID"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "proof",
        "group",
        "question",
        "admission_script"
      ],
      "description": "Type of exam item"
    },
    "parent_item_id": {
      "type": "string",
      "description": "Parent root item or parent question"
    },
    "linked_proof_id": {
      "type": "string",
      "description": "Linked parent proof ID for proof items"
    },
    "label": {
      "type": "string",
      "description": "Display label for proof or question group"
    },
    "text": {
      "type": "string",
      "description": "Question text"
    },
    "expected_answer": {
      "type": "string",
      "description": "Optional expected answer"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "attached_proof_ids": {
      "type": "object",
      "description": "JSON array of attached proof IDs"
    },
    "step_overrides": {
      "type": "object",
      "description": "Admission step wording overrides for proof items"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order"
    }
  },
  "required": [
    "exam_id",
    "item_type",
    "sort_order"
  ]
}