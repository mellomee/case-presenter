{
  "name": "JuryState",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "default": "case-presenter-trial",
      "description": "Room identifier (matches AppSettings.liveblocks_room_id)"
    },
    "published_proof_id": {
      "type": "string",
      "description": "Currently displayed proof ID (null = blank screen)"
    },
    "pdf_page": {
      "type": "number",
      "default": 1,
      "description": "Current PDF page number"
    },
    "zoom": {
      "type": "number",
      "default": 1,
      "description": "Current PDF zoom level"
    },
    "panX": {
      "type": "number",
      "default": 0,
      "description": "Current horizontal pan offset"
    },
    "panY": {
      "type": "number",
      "default": 0,
      "description": "Current vertical pan offset"
    },
    "video_time": {
      "type": "number",
      "default": 0,
      "description": "Current video playback position in seconds"
    },
    "is_playing": {
      "type": "boolean",
      "default": false,
      "description": "Whether video is currently playing"
    },
    "is_blank": {
      "type": "boolean",
      "default": true,
      "description": "Whether the jury screen is blanked"
    },
    "exhibit_label": {
      "type": "string",
      "description": "Label shown on jury screen (e.g. 'Exhibit P-1')"
    },
    "live_markup_mode": {
      "type": "string",
      "enum": ["navigate", "pen", "highlight"],
      "default": "navigate",
      "description": "Current attorney markup mode"
    },
    "live_markup_page": {
      "type": "number",
      "default": 1,
      "description": "PDF page currently being marked up"
    },
    "live_markup_strokes": {
      "type": "object",
      "description": "Live attorney freehand strokes for the active proof/page"
    },
    "live_markup_highlights": {
      "type": "object",
      "description": "Live attorney highlight rectangles for the active proof/page"
    }
  },
  "required": [
    "room_id"
  ]
}